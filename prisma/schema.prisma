// TOURÉ FAMILY HERITAGE — schéma relationnel initial
// Conçu pour évoluer (héritage, validation, réunions) sans réécriture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums partagés
// ---------------------------------------------------------------------------

enum ConfidentialityLevel {
  C0 // Public — visible sans authentification
  C1 // Grande Famille — membres authentifiés et reconnus
  C2 // Descendants directs — statut généalogique, pas la présence en réunion
  C3 // Comité restreint
}

enum ValidationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum Gender {
  FEMALE
  MALE
  UNKNOWN
}

/// Autorisation applicative (ce que l'utilisateur PEUT faire).
enum AppRole {
  GUEST
  FAMILY_MEMBER
  COMMITTEE_MEMBER
  ADMIN
}

/// Statut généalogique (qui la personne EST dans la lignée).
/// Séparé du rôle : un descendant direct n'est pas automatiquement membre du comité.
enum GenealogicalStatus {
  UNLINKED
  FAMILY_MEMBER
  DIRECT_DESCENDANT
}

enum ParentRole {
  MOTHER
  FATHER
}

enum KinshipKind {
  BIOLOGICAL
  ADOPTIVE
  FOSTER
  STEP
  OTHER
}

enum SpouseKind {
  MARRIAGE
  UNION
  OTHER
}

enum SourceType {
  ORAL_TESTIMONY
  FAMILY_ARCHIVE
  OFFICIAL_DOCUMENT
  HISTORICAL_BOOK
  ACADEMIC_PUBLICATION
  ADMINISTRATIVE_DOCUMENT
  PHOTOGRAPH
  FAMILY_WITNESS
  OTHER
}

// ---------------------------------------------------------------------------
// Utilisateur applicatif
// Clerk identifie. Cette table autorise.
// Cardinalité : 1 User ↔ 0..1 Person (fiche généalogique liée)
// ---------------------------------------------------------------------------

model User {
  id                  String              @id @default(cuid())
  clerkUserId         String              @unique
  email               String?
  firstName           String?
  lastName            String?
  role                AppRole             @default(GUEST)
  genealogicalStatus  GenealogicalStatus  @default(UNLINKED)
  personId            String?             @unique
  person              Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  lastSignedInAt      DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  auditLogs           AuditLog[]
  discussions         Discussion[]
  discussionComments  DiscussionComment[]
  votes               Vote[]
  notifications       Notification[]
  oralTestimonies     OralTestimony[]
  historicalDocuments HistoricalDocument[]
  meetingReports      MeetingReport[]
  validationRequests  ValidationRequest[]
  validationComments  ValidationComment[]
  validationDecisions ValidationDecision[]

  @@index([role])
  @@index([genealogicalStatus])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Branches familiales
// 1 FamilyBranch → N Person
// ---------------------------------------------------------------------------

model FamilyBranch {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  description           String?
  originPlace           String?
  confidentialityLevel  ConfidentialityLevel  @default(C0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  people                Person[]
  documents             HistoricalDocument[]

  @@index([confidentialityLevel])
}

// ---------------------------------------------------------------------------
// Personne — cœur généalogique
// Relations : 0..2 parents (via ParentChild), 0..N enfants, 0..N conjoints
// ---------------------------------------------------------------------------

model Person {
  id                    String                @id @default(cuid())
  firstName             String
  lastName              String
  otherNames            String?
  gender                Gender                @default(UNKNOWN)
  birthDate             DateTime?             @db.Date
  birthDateText         String?
  birthPlace            String?
  deathDate             DateTime?             @db.Date
  deathDateText         String?
  deathPlace            String?
  occupation            String?
  cityOfResidence       String?
  biography             String?
  isRoot                Boolean               @default(false)
  familyBranchId        String?
  familyBranch          FamilyBranch?         @relation(fields: [familyBranchId], references: [id], onDelete: SetNull)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  validationStatus      ValidationStatus      @default(DRAFT)
  confidenceLevel       ConfidenceLevel       @default(MEDIUM)
  portraitUrl           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user                  User?

  parentLinks           ParentChild[]         @relation("ParentToChildren")
  childLinks            ParentChild[]         @relation("ChildToParents")
  spouseLinksAsA        SpouseRelationship[]  @relation("SpouseA")
  spouseLinksAsB        SpouseRelationship[]  @relation("SpouseB")
  sources               PersonSource[]
  oralTestimonies       OralTestimony[]
  historicalDocuments   HistoricalDocument[]
  heritageMedia         HeritageMedia[]

  @@index([lastName, firstName])
  @@index([lastName])
  @@index([familyBranchId])
  @@index([confidentialityLevel])
  @@index([validationStatus])
  @@index([isRoot])
}

// Parent ↔ enfant. Unique (parent, enfant, rôle) : un père et une mère distincts.
// onDelete Cascade : supprimer une personne retire ses liens, pas le reste de l'arbre.
model ParentChild {
  id            String      @id @default(cuid())
  parentId      String
  childId       String
  parentRole    ParentRole
  kinshipKind   KinshipKind @default(BIOLOGICAL)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  parent        Person      @relation("ParentToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  child         Person      @relation("ChildToParents", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, parentRole])
  @@index([childId])
  @@index([parentId])
}

// Conjoint. personIdA < personIdB est imposé côté application.
model SpouseRelationship {
  id          String     @id @default(cuid())
  personIdA   String
  personIdB   String
  kind        SpouseKind @default(MARRIAGE)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  place       String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  personA     Person     @relation("SpouseA", fields: [personIdA], references: [id], onDelete: Cascade)
  personB     Person     @relation("SpouseB", fields: [personIdB], references: [id], onDelete: Cascade)

  @@unique([personIdA, personIdB])
  @@index([personIdB])
}

// ---------------------------------------------------------------------------
// Sources et confiance — une information n'est pas un fait tant qu'elle n'est pas sourcée
// ---------------------------------------------------------------------------

model Source {
  id                    String                @id @default(cuid())
  title                 String
  type                  SourceType
  description           String?
  url                   String?
  author                String?
  publishedAtText       String?
  confidentialityLevel  ConfidentialityLevel  @default(C0)
  confidenceLevel       ConfidenceLevel       @default(MEDIUM)
  validationStatus      ValidationStatus      @default(DRAFT)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  people                PersonSource[]

  @@index([type])
  @@index([confidentialityLevel])
  @@index([validationStatus])
}

model PersonSource {
  id        String   @id @default(cuid())
  personId  String
  sourceId  String
  notes     String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([personId, sourceId])
}

// ---------------------------------------------------------------------------
// Journal d'audit — opérations sensibles (création, modification, confidentialité)
// User optionnel : actions système. Pas de cascade destructive sur l'historique.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  previousValue  Json?
  newValue       Json?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// V2 — Vie de famille : réunions, événements, discussions, caisse, alertes
// ---------------------------------------------------------------------------

enum MeetingStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum FamilyEventKind {
  FAMILY_MEETING
  WEDDING
  BAPTISM
  FUNERAL
  CULTURAL
  HERITAGE
  ANNIVERSARY
  OTHER
}

enum DiscussionStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

model Meeting {
  id                    String                @id @default(cuid())
  title                 String
  startsAt              DateTime
  location              String?
  agenda                String?
  status                MeetingStatus         @default(UPCOMING)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([confidentialityLevel])
}

model FamilyEvent {
  id                    String                @id @default(cuid())
  title                 String
  description           String?
  startsAt              DateTime
  location              String?
  kind                  FamilyEventKind       @default(OTHER)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([startsAt])
  @@index([kind])
  @@index([confidentialityLevel])
}

model Discussion {
  id                    String                @id @default(cuid())
  title                 String
  body                  String
  status                DiscussionStatus      @default(OPEN)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  authorUserId          String?
  author                User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  comments              DiscussionComment[]
  votes                 Vote[]

  @@index([status])
  @@index([confidentialityLevel])
  @@index([createdAt])
}

model DiscussionComment {
  id            String     @id @default(cuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorUserId  String?
  author        User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  body          String
  createdAt     DateTime   @default(now())

  @@index([discussionId])
}

model Vote {
  id            String     @id @default(cuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  voterUserId   String
  voter         User       @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  choice        VoteChoice
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([discussionId, voterUserId])
  @@index([voterUserId])
}

model Contribution {
  id                    String                @id @default(cuid())
  contributorName       String
  amount                Decimal               @db.Decimal(12, 2)
  currency              String                @default("GNF")
  paidAt                DateTime              @db.Date
  purpose               String?
  status                PaymentStatus         @default(PAID)
  confidentialityLevel  ConfidentialityLevel  @default(C3)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([paidAt])
  @@index([confidentialityLevel])
}

model Expense {
  id                    String                @id @default(cuid())
  title                 String
  amount                Decimal               @db.Decimal(12, 2)
  currency              String                @default("GNF")
  spentAt               DateTime              @db.Date
  category              String?
  receiptUrl            String?
  confidentialityLevel  ConfidentialityLevel  @default(C3)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([spentAt])
  @@index([confidentialityLevel])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  href       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// MVP 3 — Héritage : témoignages, archives, médias, validation, PV
// Un témoignage n'est pas un fait. L'approbation exige un procès-verbal.
// ---------------------------------------------------------------------------

enum TestimonyStage {
  RAW
  TRANSCRIBED
  REVIEWED
  VALIDATED
  PUBLISHED
}

enum DocumentKind {
  HISTORICAL
  FAMILY_RECORD
  PHOTO
  MANUSCRIPT
  ADMINISTRATIVE
  GENEALOGICAL
  BOOK
  LETTER
  MAP
  OTHER
}

enum MediaKind {
  PHOTO
  AUDIO
  VIDEO
  DOCUMENT
  OTHER
}

enum HeritageTarget {
  SOURCE
  TESTIMONY
  DOCUMENT
}

enum DecisionKind {
  APPROVED
  REJECTED
  REVISION
}

model OralTestimony {
  id                    String                @id @default(cuid())
  title                 String
  speakerName           String
  recordedAt            DateTime?
  location              String?
  transcript            String?
  audioUrl              String?
  videoUrl              String?
  summary               String?
  historicalPeriod      String?
  stage                 TestimonyStage        @default(RAW)
  confidenceLevel       ConfidenceLevel       @default(LOW)
  validationStatus      ValidationStatus      @default(DRAFT)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  personId              String?
  person                Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  authorUserId          String?
  author                User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  media                 HeritageMedia[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([confidentialityLevel])
  @@index([validationStatus])
  @@index([stage])
  @@index([personId])
}

model HistoricalDocument {
  id                    String                @id @default(cuid())
  title                 String
  description           String?
  dateText              String?
  authorName            String?
  archiveLocation       String?
  kind                  DocumentKind          @default(OTHER)
  historicalPeriod      String?
  fileUrl               String?
  confidenceLevel       ConfidenceLevel       @default(MEDIUM)
  validationStatus      ValidationStatus      @default(DRAFT)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  personId              String?
  person                Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  familyBranchId        String?
  familyBranch          FamilyBranch?         @relation(fields: [familyBranchId], references: [id], onDelete: SetNull)
  authorUserId          String?
  author                User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  media                 HeritageMedia[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([kind])
  @@index([confidentialityLevel])
  @@index([validationStatus])
  @@index([personId])
}

model HeritageMedia {
  id                    String                @id @default(cuid())
  title                 String
  kind                  MediaKind             @default(OTHER)
  url                   String
  caption               String?
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  personId              String?
  person                Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  testimonyId           String?
  testimony             OralTestimony?        @relation(fields: [testimonyId], references: [id], onDelete: Cascade)
  documentId            String?
  document              HistoricalDocument?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now())

  @@index([confidentialityLevel])
  @@index([personId])
  @@index([testimonyId])
  @@index([documentId])
}

model MeetingReport {
  id                    String                @id @default(cuid())
  title                 String
  meetingDate           DateTime              @db.Date
  membersText           String
  decision              String
  signatureNote         String?
  fileUrl               String?
  published             Boolean               @default(false)
  confidentialityLevel  ConfidentialityLevel  @default(C1)
  authorUserId          String?
  author                User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  decisions             ValidationDecision[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([meetingDate])
  @@index([confidentialityLevel])
  @@index([published])
}

model ValidationRequest {
  id                String               @id @default(cuid())
  target            HeritageTarget
  targetId          String
  status            ValidationStatus     @default(SUBMITTED)
  submittedByUserId String?
  submittedBy       User?                @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  comments          ValidationComment[]
  decisions         ValidationDecision[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([target, targetId])
  @@index([status])
  @@index([submittedByUserId])
}

model ValidationComment {
  id           String            @id @default(cuid())
  requestId    String
  request      ValidationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorUserId String?
  author       User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime          @default(now())

  @@index([requestId])
}

model ValidationDecision {
  id               String            @id @default(cuid())
  requestId        String
  request          ValidationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind             DecisionKind
  notes            String?
  meetingReportId  String?
  meetingReport    MeetingReport?    @relation(fields: [meetingReportId], references: [id], onDelete: SetNull)
  decidedByUserId  String?
  decidedBy        User?             @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([requestId])
  @@index([meetingReportId])
  @@index([decidedByUserId])
}
